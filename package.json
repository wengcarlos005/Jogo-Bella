{
  "name": "bella-e-weng-nossa-historia",
  "private": true,
  "version": "0.2.0",
  "description": "Bella & Weng — Nossa História. RPG 2D em pixel art para os 3 anos de namoro.",
  "type": "module",
  "scripts": {
